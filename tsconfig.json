{
  "include": [
    "src",
    "types"
  ],
  "compilerOptions": {
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "module": "ESNext",   
    "target": "ES2020",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "moduleResolution": "bundler",
    "declaration": true,
    "esModuleInterop": true,      
    "noEmitOnError": false, 
    "forceConsistentCasingInFileNames": true
  }
}